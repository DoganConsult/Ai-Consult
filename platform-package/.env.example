# ═══════════════════════════════════════════════════════════════════
# DOS Platform Package R1.5 — Master Environment Configuration
# ═══════════════════════════════════════════════════════════════════
# Copy to .env and fill in values before starting the server.
# Canonical keys (DAUTH_*, DB_*, DOS_REDIS_*) are prioritized over legacy (JWT_*, PG_*, REDIS_*).
# ═══════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
LOG_LEVEL=info
PLATFORM_NAME=Dogan-AI-OS
PLATFORM_VERSION=1.5.0
DEPLOYMENT_MODE=standalone
# DEPLOYMENT_MODE: 'saas_shared' | 'saas_dedicated' | 'on_prem' (default: 'saas_shared')
# ON_PREM_SINGLE_TENANT=false
# ON_PREM_TENANT_ID=

# ── PostgreSQL (primary) ──────────────────────────────────────────
DATABASE_URL=postgresql://dos_user:CHANGE_ME@localhost:5432/dos_platform
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=dos_platform
DB_USER=dos_user
DB_PASSWORD=CHANGE_ME
DB_SSL=false
# DB_SSL_CA=/path/to/ca.pem
DB_POOL_MAX=20
DB_IDLE_TIMEOUT_MS=30000
DB_CONNECTION_TIMEOUT_MS=5000
DB_STATEMENT_TIMEOUT_MS=30000

# Legacy PostgreSQL (deprecated)
# PG_HOST=localhost
# PG_PORT=5432
# PG_DATABASE=dos_platform
# PG_USER=dos_user
# PG_PASSWORD=CHANGE_ME

# ── Redis ─────────────────────────────────────────────────────────
DOS_REDIS_HOST=localhost
DOS_REDIS_PORT=6379
DOS_REDIS_PASSWORD=
DOS_REDIS_DB=0
DOS_REDIS_PREFIX=dos:

# Legacy Redis (deprecated)
# REDIS_HOST=localhost
# REDIS_PORT=6379
# REDIS_PASSWORD=
# REDIS_DB=0
# REDIS_PREFIX=dos:

# ── Authentication (DAuth) ────────────────────────────────────────
DAUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
DAUTH_JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
DAUTH_JWT_EXPIRES_IN=15m
SECRETS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
SECRETS_MODE=env-file

# Legacy Authentication (deprecated)
# JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://platform.dogan-ai.com,https://dogan-ai.com

# ── SMTP / Email ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dogan-ai.com
SMTP_SECURE=true

# ── OpenTelemetry (observability) ─────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dos-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME

# ── ClickHouse (analytics — optional) ────────────────────────────
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dos_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Temporal (workflow orchestration — optional) ──────────────────
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── AI / LLM Providers (optional) ────────────────────────────────
AI_PROVIDER=none
# AI_PROVIDER options: 'openai' | 'anthropic' | 'google' | 'cohere' | 'ollama' | 'lmstudio'
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=

# ── Azure Key Vault (optional) ───────────────────────────────────
AZURE_KEYVAULT_ENABLED=false
# AZURE_KEY_VAULT_URL=

# ── Provisioning ─────────────────────────────────────────────────
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN

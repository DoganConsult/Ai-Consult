# ═══════════════════════════════════════════════════════════════════
# DOS Platform Package R1.5 — Production Environment Configuration
# Domain: dogan-ai.com / www.dogan-ai.com
# ═══════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
LOG_LEVEL=info
PLATFORM_NAME=Dogan-AI-OS
PLATFORM_VERSION=1.5.0
DEPLOYMENT_MODE=standalone

# ── PostgreSQL (primary) ──────────────────────────────────────────
DATABASE_URL=postgresql://dos_admin:CHANGE_ME@localhost:5432/dos_platform
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=dos_platform
DB_USER=dos_admin
DB_PASSWORD=CHANGE_ME
DB_SSL=true
# DB_SSL_CA=/etc/nginx/ssl/postgres-ca.pem
DB_POOL_MAX=25
DB_IDLE_TIMEOUT_MS=30000

# ── Redis ─────────────────────────────────────────────────────────
DOS_REDIS_HOST=localhost
DOS_REDIS_PORT=6379
DOS_REDIS_PASSWORD=
DOS_REDIS_DB=0
DOS_REDIS_PREFIX=dos:

# ── Authentication (DAuth) ────────────────────────────────────────
DAUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
DAUTH_JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
DAUTH_JWT_EXPIRES_IN=15m
SECRETS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
SECRETS_MODE=env-file

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://dogan-ai.com,https://www.dogan-ai.com,https://platform.dogan-ai.com

# ── SMTP / Email ──────────────────────────────────────────────────
SMTP_HOST=smtp.dogan-ai.com
SMTP_PORT=587
SMTP_USER=noreply@dogan-ai.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@dogan-ai.com
SMTP_SECURE=true

# ── OpenTelemetry (observability) ─────────────────────────────────
OTEL_ENABLED=true
OTEL_SERVICE_NAME=dos-platform
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
METRICS_ENABLED=true
METRICS_AUTH_TOKEN=CHANGE_ME

# ── ClickHouse (analytics — optional) ────────────────────────────
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dos_analytics

# ── Temporal (workflow orchestration — optional) ──────────────────
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=dos-platform

# ── AI / LLM Providers (optional) ────────────────────────────────
AI_PROVIDER=none
LANGGRAPH_AGENTS_ENABLED=false

# ── Azure Key Vault (optional) ───────────────────────────────────
AZURE_KEYVAULT_ENABLED=false

# ── Provisioning ─────────────────────────────────────────────────
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN

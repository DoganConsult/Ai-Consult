# ══════════════════════════════════════════════════════════
# DOS Platform Package R1.5 — On-Premises / Air-Gapped
# ══════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3010

PLATFORM_NAME=dos-platform
PLATFORM_VERSION=1.5.0
DEPLOYMENT_MODE=on-prem

DATABASE_URL=postgresql://dos_user:CHANGE_ME@db-server:5432/dos_platform
DB_SSL=true
DB_POOL_MIN=5
DB_POOL_MAX=20

REDIS_URL=redis://redis-server:6379
REDIS_TLS=false

JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

SESSION_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX

CSRF_ENABLED=true

LOG_LEVEL=info
OTEL_ENABLED=false

CLICKHOUSE_ENABLED=false
TEMPORAL_ENABLED=false

AI_PROVIDER=none
LANGGRAPH_AGENTS_ENABLED=false

SMTP_HOST=internal-smtp.local
SMTP_PORT=25
SMTP_SECURE=false

STORAGE_MODE=local
STORAGE_PATH=/var/dos-platform/storage

AZURE_KEYVAULT_ENABLED=false

SETUP_TOKEN=CHANGE_ME_TO_RANDOM_TOKEN

# ── Air-Gap Controls ──
ALLOW_EXTERNAL_HTTP=false
EXTERNAL_PROXY_URL=
OFFLINE_MODE=true

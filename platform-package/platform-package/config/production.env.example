# ══════════════════════════════════════════════════════════
# DOS Platform Package R1.5 — Production Configuration
# Domain: dogan-ai.com / www.dogan-ai.com
#
# Variable names match .env.example (canonical).
# Copy to backend/.env and fill in real values.
# ══════════════════════════════════════════════════════════

NODE_ENV=production
PORT=3010

# ── Identity ──
PLATFORM_NAME=Dogan-AI-OS
PLATFORM_VERSION=1.5.0
PLATFORM_DOMAIN=dogan-ai.com
DEPLOYMENT_MODE=standalone

# ── PostgreSQL (primary) ──
DATABASE_URL=postgresql://dos_admin:CHANGE_ME@localhost:5432/dos_platform
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=dos_platform
PG_USER=dos_admin
PG_PASSWORD=CHANGE_ME
PG_SSL=true
# PG_SSL_CA=/etc/ssl/certs/pg-ca.pem
PG_POOL_MAX=25
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
SLOW_QUERY_THRESHOLD_MS=200
MAX_TENANT_POOLS=50
POOL_IDLE_TIMEOUT_MS=60000
POOL_CLEANUP_INTERVAL_MS=300000

# ── Redis ──
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME
REDIS_DB=0
REDIS_PREFIX=dos:
DOS_REDIS_HOST=localhost
DOS_REDIS_PORT=6379
DOS_REDIS_PASSWORD=CHANGE_ME
DOS_REDIS_DB=1
DOS_REDIS_PREFIX=dos:platform:

# ── Authentication (DAuth / JWT) ──
JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX
JWT_EXPIRES_IN=15m
DAUTH_JWT_SECRET=CHANGE_ME_TO_RANDOM_64_CHAR_HEX
DAUTH_JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_RANDOM_64_CHAR_HEX
DAUTH_JWT_EXPIRES_IN=15m
SECRETS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
SECRETS_MODE=env

# ── CORS ──
CORS_ORIGINS=https://dogan-ai.com,https://www.dogan-ai.com,https://platform.dogan-ai.com

# ── Email (SMTP) ──
SMTP_HOST=smtp.dogan-ai.com
SMTP_PORT=587
SMTP_USER=noreply@dogan-ai.com
SMTP_PASS=CHANGE_ME
SMTP_FROM=noreply@dogan-ai.com
SMTP_DOMAIN=dogan-ai.com
EMAIL_FROM=noreply@dogan-ai.com
EMAIL_AUTH_TYPE=plain
BRAND_NAME=DOS Platform

# ── Observability (OpenTelemetry) ──
LOG_LEVEL=info
OTEL_ENABLED=true
OTEL_SERVICE_NAME=dos-platform
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLING_RATE=0.1
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PREFIX=dos_

# ── BullMQ (job queue) ──
BULLMQ_ENABLED=true
BULLMQ_CONCURRENCY=5
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=1000

# ── ClickHouse (analytics -- optional) ──
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dos_analytics

# ── Temporal (workflow orchestration -- optional) ──
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=dos-platform

# ── AI/LLM (optional) ──
AI_PROVIDER=none
LANGGRAPH_AGENTS_ENABLED=false

# ── Object Storage ──
STORAGE_MODE=local
STORAGE_PATH=/var/dos-platform/storage

# ── Azure Key Vault (optional) ──
AZURE_KEYVAULT_ENABLED=false

# ── SETUP Token (first-run provisioning) ──
SETUP_TOKEN=CHANGE_ME_TO_RANDOM_TOKEN

# ── Schema & RLS ──
RLS_ENABLED=false
SCHEMA_DRIFT_DETECTOR_DISABLED=false

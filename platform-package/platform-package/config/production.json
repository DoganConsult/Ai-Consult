{
  "platform": {
    "name": "dos-platform",
    "version": "1.5.0",
    "deploymentMode": "standalone",
    "domain": "dogan-ai.com"
  },
  "server": {
    "port": 3010,
    "trustProxy": true,
    "compressionLevel": 6,
    "bodyLimit": "10mb"
  },
  "database": {
    "ssl": true,
    "poolMin": 5,
    "poolMax": 25,
    "idleTimeoutMs": 30000,
    "connectionTimeoutMs": 5000,
    "statementTimeoutMs": 30000
  },
  "redis": {
    "tls": true,
    "maxRetriesPerRequest": 3,
    "connectTimeoutMs": 10000
  },
  "auth": {
    "jwtExpiresIn": "15m",
    "jwtRefreshExpiresIn": "7d",
    "csrfEnabled": true,
    "mfaEnabled": true,
    "passwordMinLength": 12,
    "maxLoginAttempts": 5,
    "lockoutDurationMs": 900000
  },
  "rateLimiting": {
    "api": { "windowMs": 60000, "maxRequests": 600 },
    "auth": { "windowMs": 60000, "maxRequests": 60 },
    "invitations": { "windowMs": 60000, "maxRequests": 20 }
  },
  "observability": {
    "logLevel": "info",
    "otelEnabled": true,
    "metricsEnabled": true,
    "healthCheckIntervalMs": 30000
  },
  "storage": {
    "mode": "local",
    "path": "/var/dos-platform/storage",
    "maxFileSizeMb": 100
  },
  "email": {
    "secure": true,
    "port": 587,
    "fromName": "DOS Platform",
    "fromAddress": "noreply@dogan-ai.com"
  },
  "security": {
    "helmet": true,
    "csp": true,
    "hsts": true,
    "frameguard": "deny",
    "inputSanitization": true,
    "corsOrigins": ["https://dogan-ai.com", "https://www.dogan-ai.com", "https://platform.dogan-ai.com"]
  },
  "features": {
    "clickhouse": false,
    "temporal": false,
    "aiProvider": "none",
    "keyVault": false,
    "vectorSearch": false
  }
}

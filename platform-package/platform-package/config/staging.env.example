# ══════════════════════════════════════════════════════════
# DOS Platform Package R1.5 — Staging Configuration
# ══════════════════════════════════════════════════════════

NODE_ENV=staging
PORT=3010

PLATFORM_NAME=dos-platform
PLATFORM_VERSION=1.5.0
PLATFORM_DOMAIN=staging.dogan-ai.com
DEPLOYMENT_MODE=standalone

DATABASE_URL=postgresql://dos_user:staging_pass@localhost:5432/dos_platform_staging
DB_SSL=false
DB_POOL_MIN=2
DB_POOL_MAX=10

REDIS_URL=redis://localhost:6379

JWT_SECRET=staging-jwt-secret-change-me
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=30d

SESSION_SECRET=staging-session-secret-change-me

CSRF_ENABLED=true

LOG_LEVEL=debug
OTEL_ENABLED=false

CLICKHOUSE_ENABLED=false
TEMPORAL_ENABLED=false

AI_PROVIDER=none
LANGGRAPH_AGENTS_ENABLED=false

SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false

STORAGE_MODE=local
STORAGE_PATH=./data/storage

SETUP_TOKEN=staging-setup-token

# ═══════════════════════════════════════════════════════════════════
# DOS Platform Package R1.5 — Environment Configuration
# Copy to .env and fill in values before starting the server.
# ═══════════════════════════════════════════════════════════════════

# ── Runtime ───────────────────────────────────────────────────────
NODE_ENV=production
PORT=3010
LOG_LEVEL=info
PLATFORM_NAME=Dogan-AI-OS
PLATFORM_VERSION=1.5.0
DEPLOYMENT_MODE=standalone

# ── PostgreSQL (primary) ──────────────────────────────────────────
DATABASE_URL=postgresql://dos_user:CHANGE_ME@localhost:5432/dos_platform
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=dos_platform
PG_USER=dos_user
PG_PASSWORD=CHANGE_ME
PG_SSL=false
# PG_SSL_CA=/path/to/ca.pem
PG_POOL_MAX=20
PG_IDLE_TIMEOUT_MS=30000
PG_CONNECTION_TIMEOUT_MS=5000
PG_STATEMENT_TIMEOUT_MS=30000
SLOW_QUERY_THRESHOLD_MS=200
MAX_TENANT_POOLS=50
POOL_IDLE_TIMEOUT_MS=60000
POOL_CLEANUP_INTERVAL_MS=300000

# ── Redis ─────────────────────────────────────────────────────────
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_PREFIX=dos:
DOS_REDIS_HOST=localhost
DOS_REDIS_PORT=6379
DOS_REDIS_PASSWORD=
DOS_REDIS_DB=1
DOS_REDIS_PREFIX=dos:platform:

# ── Authentication (DAuth) ────────────────────────────────────────
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
JWT_EXPIRES_IN=15m
DAUTH_JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
DAUTH_JWT_REFRESH_SECRET=CHANGE_ME_TO_ANOTHER_LONG_RANDOM_STRING
DAUTH_JWT_EXPIRES_IN=15m
SECRETS_ENCRYPTION_KEY=CHANGE_ME_32_BYTE_HEX_KEY
SECRETS_MODE=env

# ── CORS ──────────────────────────────────────────────────────────
CORS_ORIGINS=https://platform.dogan-ai.com

# ── SMTP / Email ──────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@dogan-ai.com
SMTP_DOMAIN=dogan-ai.com
EMAIL_FROM=noreply@dogan-ai.com
EMAIL_AUTH_TYPE=plain

# ── OpenTelemetry (observability) ─────────────────────────────────
OTEL_ENABLED=false
OTEL_SERVICE_NAME=dos-platform
OTEL_EXPORTER=otlp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SAMPLING_RATE=0.1
OTEL_DEBUG=false
METRICS_ENABLED=true
METRICS_PATH=/metrics
METRICS_PREFIX=dos_

# ── BullMQ (job queue) ───────────────────────────────────────────
BULLMQ_ENABLED=true
BULLMQ_CONCURRENCY=5
BULLMQ_DEFAULT_ATTEMPTS=3
BULLMQ_BACKOFF_TYPE=exponential
BULLMQ_BACKOFF_DELAY=1000

# ── PGMQ (PostgreSQL message queue) ──────────────────────────────
PGMQ_ENABLED=false
PGMQ_QUEUE_PREFIX=dos_

# ── ClickHouse (analytics — optional) ────────────────────────────
CLICKHOUSE_ENABLED=false
CLICKHOUSE_HOST=localhost
CLICKHOUSE_PORT=8123
CLICKHOUSE_DATABASE=dos_analytics
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# ── Apache AGE (graph — optional) ────────────────────────────────
AGE_ENABLED=false
AGE_GRAPH_NAME=dos_graph

# ── Temporal (workflow orchestration — optional) ──────────────────
TEMPORAL_ENABLED=false
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# ── AI / LLM Providers (optional — platform supports multi-model) ─
AI_PROVIDER=openai
AI_FALLBACK_PROVIDER=ollama
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o
# OPENAI_BASE_URL=https://api.openai.com/v1
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_ENDPOINT=
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-20250514
# OLLAMA_BASE_URL=http://localhost:11434

# ── Azure Key Vault (optional) ───────────────────────────────────
AZURE_KEYVAULT_ENABLED=false
# AZURE_KEYVAULT_URL=
# AZURE_KEY_VAULT_URL=

# ── OpenFGA (fine-grained authz — optional) ──────────────────────
OPENFGA_ENABLED=false
# OPENFGA_API_URL=
# OPENFGA_STORE_ID=
# OPENFGA_MODEL_ID=

# ── LangGraph (AI agent workflows — optional) ────────────────────
LANGGRAPH_AGENTS_ENABLED=false
LANGGRAPH_MAX_TOOL_ITERATIONS=10
LANGGRAPH_METRICS_RETENTION_DAYS=90

# ── Langfuse (LLM observability — optional) ──────────────────────
LANGFUSE_ENABLED=false
# LANGFUSE_HOST=
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=

# ── MCP (Model Context Protocol — optional) ──────────────────────
MCP_ENABLED=false
MCP_PORT=3011
MCP_TRANSPORT=stdio
MCP_AUTH_REQUIRED=false

# ── External Integrations (optional) ─────────────────────────────
# JIRA_BASE_URL=
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_PROJECT_KEY=GRC
# SLACK_WEBHOOK_URL=
# TEAMS_WEBHOOK_URL=
# SERVICENOW_INSTANCE_URL=
# SERVICENOW_USERNAME=
# SERVICENOW_PASSWORD=
# CISO_ASSISTANT_URL=
# CISO_ASSISTANT_API_KEY=
# OPENPROJECT_URL=
# OPENPROJECT_API_KEY=

# ── Provisioning ─────────────────────────────────────────────────
PROVISIONING_LOCKED=false
SETUP_TOKEN=CHANGE_ME_SETUP_TOKEN
ON_PREM_SINGLE_TENANT=false
# ON_PREM_TENANT_ID=

# ── Schema & RLS ─────────────────────────────────────────────────
RLS_ENABLED=false
SCHEMA_DRIFT_DETECTOR_DISABLED=false

# ── API Metadata ─────────────────────────────────────────────────
API_TITLE=DOS Platform API
API_DESCRIPTION=Dogan-AI-OS Platform API
API_CONTACT_NAME=Platform Team
API_CONTACT_EMAIL=platform@dogan-ai.com
BRAND_NAME=Dogan-AI-OS

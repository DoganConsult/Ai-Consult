      { "code": "vendor_manager", "name_en": "Vendor Manager", "name_ar": "مدير الموردين", "home_route": "/workspace-home", "permissions": ["vendors:*", "contracts:*"] },
      { "code": "viewer", "name_en": "Viewer", "name_ar": "مشاهد", "home_route": "/workspace-home", "permissions": ["analytics:read"] }

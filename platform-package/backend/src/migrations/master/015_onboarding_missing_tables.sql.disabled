-- 4.5 Training Schedules
CREATE TABLE IF NOT EXISTS public.training_schedules (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  tenant_id VARCHAR(16) NOT NULL REFERENCES tenants(tenant_id) ON DELETE CASCADE,

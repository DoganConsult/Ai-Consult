[Unit]
Description=Dogan AI OS - pgBackRest backup runner
Wants=postgresql@18-main.service
After=postgresql@18-main.service

[Service]
Type=oneshot
User=postgres
Group=postgres
ExecStart=/root/Ai-Consult-Microservices/ops/pgbackrest/backup-runner.sh
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/var/lib/pgbackrest /var/log/pgbackrest
PrivateTmp=true
